## Xcode
##
# Xcode
#
# gitignore contributors: remember to update Global/Xcode.gitignore, Objective-C.gitignore & Swift.gitignore

## User settings
xcuserdata/

## compatibility with Xcode 8 and earlier (ignoring not required starting Xcode 9)
*.xcscmblueprint
*.xccheckout

## Obj-C/Swift specific
*.hmap
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# Swift Package Manager
#
# Add this line if you want to avoid checking in the Swift Package Manager's
# Xcode project folder
# .swiftpm/xcode
.swiftpm/xcode/xcuserdata/

# Add this line if you want to avoid checking in the dependency files
# .build/
.build/

# CocoaPods
#
# We recommend not adding the Pods directory to your .gitignore. However, if
# you prefer to do so, uncomment the following line.
# Pods/

# Carthage
#
# Add this line if you want to avoid checking in the Carthage build directory.
# Carthage/Build
Carthage/Build/

# fastlane
#
# It is recommended to not add the generated screenshots, frameit screenshots and
# certificates to your .gitignore.
# fastlane/report.xml
# fastlane/Preview.html
# fastlane/screenshots/**/*.png
# fastlane/test_output.xml
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Code Injection
#
# After code injection, you can uncomment the following lines to see all the
# files changed.
# *.io.tailor.*
# *.tailor.json
*.xcuserstate

# Mac
.DS_Store

# Build
build/
DerivedData/

# xcuserdata - never commit user-specific data
*.xcuserdatad/
xcuserdata/

# Xcode schemes - shared schemes should be committed (in xcshareddata)
# But user schemes shouldn't
*.xcscheme
xcschememanagement.plist
